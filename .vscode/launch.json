{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "cpmdisk – create fdd",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/cpmdisk",
            "args": ["create", "test.dsk", "fdd"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/bin",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake-build"
        },
        {
            "name": "cpmdisk – list test.dsk",
            "type": "cppdbg",
            "request": "launch",
